# Copy to supabase/functions/.env for local development (`supabase functions serve`).
# In production, set it with: supabase secrets set GBFS_URL=...

# Discovery feed (gbfs.json) of any GBFS v3 network. Default: TBM Le Vélo, Bordeaux (public open-data key).
GBFS_URL=https://bdx.mecatran.com/utw/ws/gbfs/bordeaux/v3/gbfs.json?apiKey=opendata-bordeaux-metropole-flux-gtfs-rt

# Email alerts (alert-subscribe, send-alerts), sent through Resend (https://resend.com).
# A Resend API key with "Sending access". Never commit the real one.
RESEND_API_KEY=re_...
# Sender. onboarding@resend.dev works without a domain but only delivers to your Resend account's own address.
ALERT_FROM=Dock Radar <onboarding@resend.dev>
# Where the front end is served: confirm and unsubscribe links point here.
SITE_URL=http://localhost:8080
