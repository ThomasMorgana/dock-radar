# Copy to supabase/functions/.env for local development (`supabase functions serve`).
# In production, set it with: supabase secrets set GBFS_URL=...

# Discovery feed (gbfs.json) of any GBFS v3 network. Default: TBM Le Vélo, Bordeaux (public open-data key).
GBFS_URL=https://bdx.mecatran.com/utw/ws/gbfs/bordeaux/v3/gbfs.json?apiKey=opendata-bordeaux-metropole-flux-gtfs-rt
